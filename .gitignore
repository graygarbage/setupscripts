# Ignore environment-specific files
*.env
!*.enc.env
*.log

# Ignore plaintext secret files and private keys in the repository
keys.txt
*.agekey
secrets/*
!secrets/*.enc
!secrets/*.enc.*
!secrets/*.sops.*
!secrets/.gitkeep

# Ignore temporary files
*.swp
*~

# Ignore build artifacts
*.o
*.out

# Ignore IDE-specific files
.vscode/
.idea/

# Ignore backup files
*.bak

# Ignore OS-specific files
.DS_Store
Thumbs.db
